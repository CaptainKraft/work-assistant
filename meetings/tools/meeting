#!/usr/bin/env bash
# Convenience wrapper: run meeting.py with the tool's own venv interpreter.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="$here/.venv/bin/python"
if [[ ! -x "$py" ]]; then
  echo "error: venv not found at $here/.venv" >&2
  echo "set it up with:" >&2
  echo "  python3 -m venv \"$here/.venv\" && \"$here/.venv/bin/pip\" install -r \"$here/requirements.txt\"" >&2
  exit 1
fi
exec "$py" "$here/meeting.py" "$@"
